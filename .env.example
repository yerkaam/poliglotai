# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# Set to 1 behind HTTPS
AUTH_COOKIE_SECURE=0

POSTGRES_DB=poliglot
POSTGRES_USER=poliglot
POSTGRES_PASSWORD=poliglot

# AI chat. Without a key an offline stub tutor answers.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=low
CHAT_DAILY_LIMIT=30

# Email confirmation with a 6-digit code after registration (0 turns it off)
REQUIRE_EMAIL_VERIFICATION=1
# Registration codes and password-reset emails. The console backend prints them to the log;
# for real users use SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PoliglotAi <no-reply@poliglot.ai>
